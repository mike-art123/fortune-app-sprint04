// Foundation schema (doc 52 §17) + Sprint 04 identity/entitlements (doc 53).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Persian calendar birth months (profile onboarding, scope §16).
enum BirthMonth {
  FARVARDIN
  ORDIBEHESHT
  KHORDAD
  TIR
  MORDAD
  SHAHRIVAR
  MEHR
  ABAN
  AZAR
  DEY
  BAHMAN
  ESFAND
}

/// User anchored to Telegram identity (`tg:<id>` = the unique telegramId).
model User {
  id                    String      @id @default(cuid())
  telegramId            String      @unique @map("telegram_id")
  displayName           String?     @map("display_name")
  locale                String      @default("fa")
  birthMonth            BirthMonth? @map("birth_month")
  onboardingCompleted   Boolean     @default(false) @map("onboarding_completed")
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at")
  profileVersion        Int         @default(0) @map("profile_version")

  /// Scope §4: personalization is on by default and can be switched off for
  /// good. Stored on the user, not on the device, so turning it off once turns
  /// it off everywhere.
  personalizationOptOut Boolean  @default(false) @map("personalization_opt_out")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  idempotencyKeys        IdempotencyKey[]
  subscription           Subscription?
  wallet                 Wallet?
  dailyUsage             DailyFortuneUsage[]
  mediationSessions      AdMediationSession[]
  rewardedAdEntitlements RewardedAdEntitlement[]
  summaries              AiSummaryCache[]
  notificationPreference NotificationPreference?
  notifications          NotificationDelivery[]
  reflections            ReflectionEntry[]

  @@map("users")
}

/// Scope §8: what someone wrote to themselves after a reading.
///
/// This is the most private row in the database. `note` is never read by any
/// feature: it is not summarised, not searched server-side, not counted, never
/// put in a prompt, and never logged. The only things that leave this table are
/// the rows themselves, back to the person who wrote them.
///
/// `readingId` is nullable so a thought that belongs to no particular reading
/// still has a home; the unique pair keeps at most one reflection per reading
/// while leaving standalone entries unconstrained (Postgres treats NULLs as
/// distinct).
model ReflectionEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  readingId String?  @map("reading_id")
  feeling   String
  note      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, readingId])
  @@index([userId, createdAt])
  @@map("reflection_entries")
}

/// Scope §7: what this person agreed to hear from us, and when.
///
/// Every field is a limit, not a capability: quiet hours, a daily cap, and a
/// mute that ends by itself. Defaults are deliberately modest — one message a
/// day at most, nothing between 22:00 and 08:00 local, and the weekly look-back
/// off until it is asked for.
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  dailyFortune   Boolean  @default(true) @map("daily_fortune")
  streakReminder Boolean  @default(true) @map("streak_reminder")
  weeklySummary  Boolean  @default(false) @map("weekly_summary")
  quietFromHour  Int      @default(22) @map("quiet_from_hour")
  quietToHour    Int      @default(8) @map("quiet_to_hour")
  dailyCap       Int      @default(1) @map("daily_cap")
  timeZone       String   @default("Asia/Tehran") @map("time_zone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  /// Set by «فعلاً چیزی نفرست»; when it passes, messages resume on their own.
  mutedUntil DateTime? @map("muted_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Scope §7: one row per message we decided to send.
///
/// `(userId, kind, dateKey)` is unique, so a sweep that runs twice — or two
/// sweeps racing — can never send the same thing twice, and counting today's
/// rows is how the daily cap is enforced. The row holds the kind, never the
/// text: what was written is not worth keeping.
model NotificationDelivery {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String
  dateKey   String   @map("date_key")
  status    String   @default("sent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, dateKey])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

/// Scope §6: one cached history summary per reader per range.
///
/// It holds the sentence that was shown and a fingerprint of the readings it
/// was counted from — never a reading's text. Add or delete a reading and the
/// fingerprint no longer matches, so a summary describing a reading that no
/// longer exists can never be served; deleting the user deletes the summaries
/// with them. `source` is "ai" when a model wrote the sentence and "rules"
/// when the app did, so the two are never confused for each other.
model AiSummaryCache {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  rangeKey    String   @map("range_key")
  fingerprint String
  summary     String
  source      String   @default("rules")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rangeKey])
  @@map("ai_summary_cache")
}

/// Simple key/value system settings, audit-friendly.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Server-side feature flags (doc 52 §36).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Durable idempotency records for retry-safe operations (doc 52 §30).
model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  operation   String
  key         String
  fingerprint String
  result      String
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Outbox events written in the same transaction as state changes (doc 52 §32).
model OutboxEvent {
  id          String    @id @default(cuid())
  name        String
  payload     String
  requestId   String?   @map("request_id")
  occurredAt  DateTime  @map("occurred_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt])
  @@map("outbox_events")
}

/// The Divan itself, one ghazal per row (docs/hafez-dataset-sourcing.md).
///
/// Corpus, not user data: rows are written by the seed import and never by the
/// app — a fal draws from the Divan, it does not edit it. `verses` holds the
/// couplets as JSON text, `[["hemistich","hemistich"],…]` in reading order —
/// the same store-as-text pattern `Reading.inputJson` uses. `edition` names
/// the dump a row came from, so a re-import is a visible replacement under a
/// new tag rather than a silent drift, and `(edition, number)` is the identity
/// selection will resolve against: whatever count the seed asserted is the
/// whole range a fal may draw from.
model Ghazal {
  id          String   @id @default(cuid())
  number      Int
  openingLine String   @map("opening_line")
  verses      String
  edition     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([edition, number])
  @@map("ghazals")
}

/// One generated reading. Sprint 04: new rows always carry the owner; null
/// userId only survives on pre-auth legacy rows.
model Reading {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  fortuneId String    @map("fortune_id")
  title     String
  content   String
  inputJson String    @map("input_json")
  requestId String?   @map("request_id")
  createdAt DateTime  @default(now()) @map("created_at")
  savedAt   DateTime? @map("saved_at")

  @@index([userId, createdAt])
  @@index([userId, savedAt])
  @@map("readings")
}

/// One wallet per identity. Sprint 04 re-anchors wallets to `userId`;
/// `anonId` remains only as a migration breadcrumb for pre-auth wallets.
/// `balance` is denormalized for cheap reads but is ONLY ever mutated in the
/// same transaction that writes the matching CoinTransaction row — the ledger
/// is the truth, the balance is the cache of it.
model Wallet {
  id        String   @id @default(cuid())
  userId    String?  @unique @map("user_id")
  anonId    String?  @unique @map("anon_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // onDelete: Restrict (not Cascade, unlike IdempotencyKey/Subscription):
  // a wallet's CoinTransaction ledger must never be silently orphaned or
  // deleted alongside its owner. Deleting a User with a wallet fails the FK
  // check until the wallet (and its ledger) is explicitly handled.
  user         User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions CoinTransaction[]

  @@map("wallets")
}

/// Append-only ledger row. `amount` is signed: positive = credit,
/// negative = debit. Rows are never updated or deleted.
///
/// Sprint 04: `refType`/`refId` tie a row to what caused it — a debit carries
/// the client Idempotency-Key, a refund carries the id of the debit it
/// reverses. The unique constraint is the database-level backstop against
/// duplicate charges and duplicate refunds (NULL refIds stay unconstrained).
model CoinTransaction {
  id        String   @id @default(cuid())
  walletId  String   @map("wallet_id")
  amount    Int
  kind      String
  reason    String?
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([walletId, kind, refId])
  @@index([walletId, createdAt])
  @@map("coin_transactions")
}

/// VIP subscription entitlement. One per user. Activated by verified Telegram
/// Stars payments (or a system grant); `platformTransactionId` stores the last
/// applied telegram_payment_charge_id so a webhook retry never extends twice.
model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  plan                  String
  status                String
  currentPeriodEnd      DateTime @map("current_period_end")
  autoRenew             Boolean  @default(false) @map("auto_renew")
  platformTransactionId String?  @unique @map("platform_transaction_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Per-user, per-day free-allowance counter (coins removed). One row per
/// (user, dateKey, fortuneId); `dateKey` is the server-computed YYYY-MM-DD in
/// the app timezone. The unique key makes granting the daily free reading
/// atomic, and the count is only ever incremented after a successful reading.
model DailyFortuneUsage {
  id                       String   @id @default(cuid())
  userId                   String   @map("user_id")
  dateKey                  String   @map("date_key")
  fortuneId                String   @map("fortune_id")
  successfulFreeUsageCount Int      @default(0) @map("successful_free_usage_count")
  lastFreeUsedAt           DateTime @default(now()) @map("last_free_used_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, fortuneId])
  @@index([userId, dateKey])
  @@map("daily_fortune_usage")
}

/// One rewarded-ad mediation attempt-chain for a single pending fortune request
/// (coins removed). The backend owns provider ordering and fallback; the client
/// never hardcodes a provider. A session yields at most one verified reward
/// (enforced by the 1:1 entitlement), and `(userId, idempotencyKey)` is unique
/// so a retry of the same pending request never spawns a duplicate chain.
model AdMediationSession {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  fortuneId       String    @map("fortune_id")
  status          String    @default("created")
  providerOrder   String    @map("provider_order")
  currentProvider String?   @map("current_provider")
  attemptCount    Int       @default(0) @map("attempt_count")
  idempotencyKey  String    @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  expiresAt       DateTime  @map("expires_at")

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    AdProviderAttempt[]
  entitlement RewardedAdEntitlement?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("ad_mediation_sessions")
}

/// One provider attempt inside a mediation session. `(session, attemptNumber)`
/// is unique so each attempt is recorded exactly once; the status/failureReason
/// feed both fallback decisions and per-provider reporting.
model AdProviderAttempt {
  id                 String    @id @default(cuid())
  mediationSessionId String    @map("mediation_session_id")
  provider           String
  providerSessionId  String?   @map("provider_session_id")
  attemptNumber      Int       @map("attempt_number")
  status             String    @default("created")
  failureReason      String?   @map("failure_reason")
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  verifiedAt         DateTime? @map("verified_at")

  session AdMediationSession @relation(fields: [mediationSessionId], references: [id], onDelete: Cascade)

  @@unique([mediationSessionId, attemptNumber])
  @@index([mediationSessionId])
  @@map("ad_provider_attempts")
}

/// The one-time fortune unlock issued after a server-verified reward. One per
/// mediation session (`mediationSessionId` unique) and one per provider reward
/// (`(provider, providerRewardId)` unique) — so a single ad can never unlock
/// more than one fortune and a reward id can never be replayed.
model RewardedAdEntitlement {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  fortuneId          String    @map("fortune_id")
  mediationSessionId String    @unique @map("mediation_session_id")
  provider           String
  providerRewardId   String    @map("provider_reward_id")
  status             String    @default("available")
  createdAt          DateTime  @default(now()) @map("created_at")
  consumedAt         DateTime? @map("consumed_at")
  expiresAt          DateTime  @map("expires_at")

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AdMediationSession @relation(fields: [mediationSessionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRewardId])
  @@index([userId, createdAt])
  @@map("rewarded_ad_entitlements")
}
