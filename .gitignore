# Node
node_modules/

# Local-only production secrets staged for the operator to paste into Railway.
# NEVER commit these.
deploy-secrets/
dist/
coverage/
*.log
.npm/

# Env / secrets — never commit real secrets
.env
.env.*
!.env.example

# Prisma
apps/api/prisma/*.db

# Local corpus drops (docs/hafez-dataset-sourcing.md): raw dumps stay out of
# git; what ships is the extracted, counted JSON under apps/api/prisma/data.
/data/

# Flutter / Dart
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/.packages
apps/mobile/pubspec.lock
**/*.g.dart
**/*.freezed.dart

# Generated native shells (created by `flutter create .`). The web/ target is
# committed (Sprint 05) — the Telegram Mini App ships as a web build — and so
# is android/ (Sprint Android): it carries the Play identity, signing config
# and launcher art; its own .gitignore keeps wrapper/keystore files out.
# ios/ is committed too (Sprint iOS): it carries the App Store identity and
# Info.plist; its own .gitignore keeps Pods/ and ephemeral files out.
apps/mobile/macos/
apps/mobile/linux/
apps/mobile/windows/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Scratch: swept git locks + files staged for removal (device mount can't unlink)
_to_delete/
